# Provedor de visão: "gemini" ou "anthropic".
# Se omitido, usa Gemini quando GEMINI_API_KEY existir; senão, Anthropic.
# VISION_PROVIDER=gemini

# --- Gemini (camada gratuita do Google AI Studio) ---------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Padrão: gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic ---------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Obrigatório só se a chave não estiver vinculada a um workspace
# ANTHROPIC_WORKSPACE_ID=
# Opcional. Padrão: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
